# ============================================================
# Kan M WhatsApp Bot — variables de entorno
# Copiar a .env y completar con los valores reales.
# El .env real NUNCA se commitea (está en .gitignore).
# En Railway estas variables se configuran en Settings → Variables.
# ============================================================

# --- Meta (WhatsApp Cloud API) --- [REQUERIDAS]
# Token secreto que inventas tú. Se compara con hub.verify_token cuando Meta
# verifica el webhook. Usa el mismo valor al configurar el webhook en Meta.
META_VERIFY_TOKEN=

# Token de acceso del número (Meta → WhatsApp → API Setup → access token).
# En producción usa un token permanente de un System User.
META_WHATSAPP_TOKEN=

# ID del número (Meta → WhatsApp → API Setup → Phone number ID).
META_PHONE_NUMBER_ID=

# App Secret de la App de Meta (Settings → Basic). Valida X-Hub-Signature-256.
META_APP_SECRET=

# (Opcional) Versión de la Graph API. Default: v21.0
META_GRAPH_VERSION=v21.0

# --- Base de datos Neon (Postgres) --- [REQUERIDA]
# La MISMA base que la web; el bot solo usa tablas wa_*.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- IA — Gemini Developer API --- [REQUERIDA]
# Obtén tu API key gratis en https://aistudio.google.com/apikey
# NO requiere billing de Google Cloud ni Vertex AI — es la Gemini Developer API.
GEMINI_API_KEY=

# --- Notificaciones internas --- [REQUERIDA]
# Número de la dueña (formato internacional, ej. 1809XXXXXXX).
OWNER_PHONE=

# --- Logging ---
# Niveles: DEBUG, INFO, WARNING, ERROR. Default: INFO
LOG_LEVEL=INFO
